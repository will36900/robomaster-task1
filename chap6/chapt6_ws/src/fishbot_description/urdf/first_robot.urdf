<?xml version="1.0"?>
<!-- URDF 是结构说明文件，本身不会主动发布坐标变换。 -->
<robot name = "first_robot"> 
    <!-- the body of the robot -->
    <link name = "base_link">
        <!-- 外观描述 -->
        <visual>
            <!-- visual 几何体相对于 base_link 坐标系的平移和旋转 -->
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
            <!-- 几何形状 -->
            <geometry>
                <!-- 圆柱体 半径 高度 -->
                    <cylinder radius="0.1" length="0.12"/>
                </geometry>
                <!-- 材质颜色 -->
            <material name = "white">
                <color rgba="1.0 1.0 1.0 0.5"/>
            </material>  
           
        </visual>
    </link>
    <!-- 机器人的imu部件，惯性测量传感器 -->
    <link name = "imu_link">
        <visual>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
            <geometry>
                <box size = "0.1 0.1 0.1"/>
            </geometry>
            <material name = "black">
                <color rgba="0.0 0.0 0.0 0.5"/>
            </material>
        </visual>
    </link>
    <!-- 机器人的关节,用于组合机器人的部件 -->
    <joint name = "base_to_imu" type = "fixed"> <!-- 固定的关节 -->
    <parent link = "base_link"/>
    <child link = "imu_link"/>
    <origin xyz = "0 0 0.1" rpy = "0 0 0"/>
    </joint>


</robot>

