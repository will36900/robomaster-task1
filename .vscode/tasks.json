{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ROS 2: build demo_cpp_pkg",
            "type": "shell",
            "command": "source /opt/ros/lyrical/setup.bash && colcon build --packages-select demo_cpp_pkg --cmake-args -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
            "options": {
                "cwd": "${workspaceFolder}/chapt2_ws"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "ROS 2: run active node",
            "type": "shell",
            "command": "source /opt/ros/lyrical/setup.bash && source install/setup.bash && ros2 run demo_cpp_pkg '${fileBasenameNoExtension}'",
            "options": {
                "cwd": "${workspaceFolder}/chapt2_ws"
            },
            "dependsOn": "ROS 2: build demo_cpp_pkg",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}