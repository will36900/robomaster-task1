{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ROS 2: 调试当前节点",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/chap2/chapt2_ws/install/demo_cpp_pkg/lib/demo_cpp_pkg/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/chap2/chapt2_ws",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/opt/ros/lyrical/lib:${env:LD_LIBRARY_PATH}"
        },
        {
          "name": "AMENT_PREFIX_PATH",
          "value": "${workspaceFolder}/chap2/chapt2_ws/install/demo_cpp_pkg:/opt/ros/lyrical"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "ROS 2: build demo_cpp_pkg",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
